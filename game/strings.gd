	# --- Level 2 numbers (the team's Mars-surface model): filled in from the scenario, so both starts share the texts
	"eng_f1_1": ["1 of our 4 power units is off: we have {p0}% power.", "1 de nuestras 4 unidades de energía está apagada: tenemos {p0}% de energía."],
	"eng_f1_2": ["2 of our 4 power units are off: we have {p0}% power.", "2 de nuestras 4 unidades de energía están apagadas: tenemos {p0}% de energía."],
	"eng_f2": ["If we repair one unit, we wake up with {p1}%. If not, with {p0}%.", "Si reparamos una unidad, amanecemos con {p1}%. Si no, con {p0}%."],
	"eng_f3": ["Our goal: 75% power or more at dawn.", "Nuestra meta: 75% de energía o más al amanecer."],
	"pro_f1_big": ["A big solar storm hits in 30 minutes.", "Una tormenta solar grande llega en 30 minutos."],
	"pro_f1_small": ["A small solar storm hits in 30 minutes.", "Una tormenta solar chica llega en 30 minutos."],
	"pro_f2": ["In our thin shelter, today would count as {xt} sols of normal radiation. With water and cargo around it: {xs}.", "En nuestro refugio delgado, hoy contaría como {xt} soles de radiación normal. Con agua y carga alrededor: {xs}."],
	"pro_f3": ["Our goal: 6 sols of radiation or less today.", "Nuestra meta: 6 soles de radiación o menos hoy."],
	"note_eng": ["{n} of 4 units off: {p0}% power. Repair one: {p1}%. Goal: 75% or more.", "{n} de 4 unidades apagadas: {p0}% de energía. Reparar una: {p1}%. Meta: 75% o más."],
	"note_pro_big": ["Big storm: {xt} sols in the thin shelter, {xs} reinforced. Goal: 6 or less.", "Tormenta grande: {xt} soles en el refugio delgado, {xs} reforzado. Meta: 6 o menos."],
	"note_pro_small": ["Small storm: {xt} sols in the thin shelter, {xs} reinforced. Goal: 6 or less.", "Tormenta chica: {xt} soles en el refugio delgado, {xs} reforzado. Meta: 6 o menos."],
	"a_gain": ["Less radiation today", "Menos radiación hoy"],
	"a_cost": ["The broken unit stays off: fewer oxygen tanks tonight, and no light for the plants", "La unidad dañada sigue apagada: menos tanques de oxígeno esta noche, y las plantas sin luz"],
	"b_gain": ["One power unit comes back on", "Una unidad de energía vuelve a funcionar"],
	"b_cost": ["The shelter stays thin: more radiation today", "El refugio sigue delgado: más radiación hoy"],
	"donki_a": ["Eruption recorded by NASA DONKI on 20 May 2024, on the far side of the Sun. That day Curiosity measured its largest radiation surge on Mars (NASA JPL). Archived data.", "Erupción registrada por NASA DONKI el 20 de mayo de 2024, en la cara oculta del Sol. Ese día Curiosity midió su mayor aumento de radiación en Marte (NASA JPL). Dato archivado."],
	"donki_b": ["Solar particle event recorded by NASA DONKI near Earth on 10 September 2017. The next day Curiosity measured a radiation surge on Mars (NASA JPL). Archived data.", "Evento de partículas solares registrado por NASA DONKI cerca de la Tierra el 10 de septiembre de 2017. Al día siguiente Curiosity midió un aumento de radiación en Marte (NASA JPL). Dato archivado."],
	"earth_late_a": ["“We see a big solar storm heading your way. Reinforce your shelter!”", "«Vemos una tormenta solar grande que va hacia ustedes. ¡Refuercen su refugio!»"],
	"cmd_storm": ["Too late to help us, and Earth could not see our power fault. Solar particles are invisible: we draw them so you can see the storm.", "Ya no nos ayuda, y la Tierra no podía ver nuestra falla de energía. Las partículas solares son invisibles: las dibujamos para que vean la tormenta."],
	"cmd_storm2": ["The crew waits in the shelter. Solar particles are invisible: we draw them so you can see the storm.", "La tripulación espera en el refugio. Las partículas solares son invisibles: las dibujamos para que vean la tormenta."],
	"night_low": ["Night. With {p}% power the lights are low, the greenhouse lamp is off, and the oxygen machine fills only {m} of its 2 tanks.", "De noche. Con {p}% de energía las luces están bajas, la lámpara del invernadero está apagada, y la máquina de oxígeno llena sólo {m} de sus 2 tanques."],
	"night_full": ["Night. With 100% power the lights and the greenhouse lamp are on, and the oxygen machine fills 2 tanks.", "De noche. Con 100% de energía las luces y la lámpara del invernadero están encendidas, y la máquina de oxígeno llena 2 tanques."],
	"goal_power": ["Power at dawn: {p}%. Goal: 75% or more.", "Energía al amanecer: {p}%. Meta: 75% o más."],
	"goal_rad": ["Radiation today: {x} sols. Goal: 6 or less.", "Radiación de hoy: {x} soles. Meta: 6 o menos."],
	"cost_a": ["What it cost: the unit is still broken. The oxygen machine filled fewer tanks, and the plants got no light.", "Lo que costó: la unidad sigue dañada. La máquina de oxígeno llenó menos tanques, y las plantas no tuvieron luz."],
	"cost_b": ["What it cost: the shelter stayed thin. This radiation never goes back down.", "Lo que costó: el refugio se quedó delgado. Esta radiación nunca baja."],
	"goal_met": ["Goal met", "Meta cumplida"],
	"goal_not": ["Goal not met", "Meta no cumplida"],
	"pick_yes": ["Yes: that job met both goals.", "Sí: ese trabajo cumplió las dos metas."],
	"pick_no": ["That job missed a goal. Look at its bars again.", "Ese trabajo no cumplió una meta. Miren otra vez sus barras."],
	"pick_fb": ["There is no wrong pick. Tell each other why.", "No hay elección equivocada. Cuéntense por qué."],
	"lesson_a": ["Engineering alone would have repaired the power. Protection alone would have reinforced the shelter. Only together could you see which risk was bigger.", "Ingeniería sola habría reparado la energía. Protección sola habría reforzado el refugio. Sólo juntos pudieron ver cuál riesgo era mayor."],
	"lesson_q": ["Yesterday's choice is not over. Play the next sol and see what it left you.", "La decisión de ayer no ha terminado. Jueguen el siguiente sol y vean qué les dejó."],
	"btn_other_storm": ["Play the next sol", "Jugar el siguiente sol"],
	"cmd_b_intro": ["Sol 31. Yesterday's choice is still with us. Check your consoles again.", "Sol 31. La decisión de ayer sigue con nosotros. Revisen sus consolas otra vez."],
	"lesson_b": ["Yesterday's choice shaped today. Nobody sees everything: talk before you use your one job.", "La decisión de ayer le dio forma al día de hoy. Nadie ve todo: platiquen antes de usar su único trabajo."],

