static func t(key: String, lang: String) -> String:
	if not S.has(key):
		return key
	return S[key][1 if lang == "es" else 0]

static func date(y: int, m: int, d: int, lang: String) -> String:
	var mname: String = MONTHS["es" if lang == "es" else "en"][clampi(m, 1, 12) - 1]
	if lang == "es":
		return "%d de %s de %d" % [d, mname, y]
	return "%d %s %d" % [d, mname, y]
